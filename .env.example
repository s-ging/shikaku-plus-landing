# Copy to `.env` and fill in. PUBLIC_* are exposed to the browser (safe: anon
# key + url only). Everything else is server-only and must stay secret.

# ─── Supabase (the tally) ───────────────────────────────────────────────────
# Browser bar reads + subscribes with these:
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Server webhooks write with the service-role key (bypasses RLS) — NEVER public:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── PayMongo (QR Ph / cards) ───────────────────────────────────────────────
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_WEBHOOK_MODE=test          # "test" or "live"

# ─── Crypto via Alchemy (USDC/USDT on Ethereum) ─────────────────────────────
ALCHEMY_SIGNING_KEY=
DONATION_ETH_ADDRESS=0x30147c42a4ef55a766ba334489197b6d5f79530f
# Comma-separated sender addresses to EXCLUDE (e.g. a client who pays you at the
# same address). Transfers from these are skipped, not counted as donations.
CRYPTO_IGNORE_FROM=

# ─── PayPal (business account required) ─────────────────────────────────────
PAYPAL_ENV=sandbox                  # "sandbox" or "live"
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=

# ─── Wise ───────────────────────────────────────────────────────────────────
# Wise's PUBLIC key (PEM). Use the sandbox key while testing, the live key in prod.
WISE_PUBLIC_KEY=
